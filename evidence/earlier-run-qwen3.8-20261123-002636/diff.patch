+    def release_expired_advances(self):
+        """Releases every expired advance with a remaining balance above zero:
+        sets remaining to 0 and writes a 'release' row with the negative amount.
+        Returns the total released as a float."""
+        today = datetime.date.today().strftime("%Y-%m-%d")
+        with self._lock:
+            cur = self.cursor()
+            cur.execute("SELECT id, remaining FROM payments "
+                        "WHERE type='advance' AND remaining > 0 "
+                        "AND expires_on IS NOT NULL AND expires_on < ?", (today,))
+            rows = cur.fetchall()
+            total = 0.0
+            for r in rows:
+                rem = float(r[1] or 0)
+                if rem <= 0:
+                    continue
+                cur.execute("UPDATE payments SET remaining = 0 WHERE id=?", (r[0],))
+                cur.execute(
+                    "INSERT INTO payments (company_id, date, type, amount, remaining, "
+                    "operator_id, created_at) VALUES (?,?, 'release', ?,0,?,?)",
+                    (None, today, -rem, "SYSTEM",
+                     datetime.datetime.now().isoformat(timespec="seconds")))
+                total += rem
+            self.conn.commit()
+            return round(total, 2)
