data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Editors and IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Operating system files
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Temporary files
tmp/
*.tmp
*.bak
