# Python bytecode and packaging
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# Virtual environments
venv/
.venv/
env/

# Test and tooling caches
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Local settings and secrets (never commit)
harness.json
config_local.json
.env
.env.*
*.pem
*.key

